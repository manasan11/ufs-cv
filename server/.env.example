# Server
PORT=4000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=cvapp
DB_PASSWORD=cvapp_dev_pw
DB_NAME=cv_generator
DB_CONNECTION_LIMIT=10

# Auth - CHANGE THIS to a long random value in any real deployment
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=7d
# When true, every CV endpoint requires a valid bearer token
AUTH_REQUIRED=false

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:4200
